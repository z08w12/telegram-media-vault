TELEGRAM_ENABLED=true
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_my_telegram_org_api_hash
TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_ALLOWED_USER_IDS=123456789
ADMIN_PASSWORD_HASH=scrypt$32768$8$1$replace_salt$replace_hash
SESSION_SECRET=replace_with_a_long_random_value
PUBLIC_ORIGIN=https://media.example.com
COOKIE_PATH=/telegram/
DATA_DIR=/var/lib/telegram-media
WEB_DIR=/opt/telegram-media/web
MAX_FILE_BYTES=2147483648
DISK_RESERVE_BYTES=5368709120
TRASH_RETENTION_DAYS=30
